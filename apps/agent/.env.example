# Copy to apps/agent/.env for local development. Blank values count as unset.

# development | test | production
NODE_ENV=development
# Defaults to CONDUCTOR_PORT + 1 under Conductor, otherwise 4000. Render sets it.
PORT=
# Comma-separated CORS allow-list. Defaults to http://localhost:${CONDUCTOR_PORT:-3000}; required in production.
WEB_ORIGIN=

# Required.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_FALLBACK_MODEL=claude-sonnet-5-5

# Optional. Without it, TOOLS_MODE=auto uses the offline mock engine.
SERPAPI_API_KEY=
# Optional. Gives the itinerary planner real attraction data.
TAVILY_API_KEY=
# auto (SerpAPI if a key is set, else mock) | live (SerpAPI only) | mock
TOOLS_MODE=auto

# Optional. postgres:// URL enables PostgresSaver and the `trips` table ("My trips"); without it both are kept in memory.
# Local Postgres: `docker compose up -d` in apps/agent, then DATABASE_URL=postgres://postgres:postgres@localhost:5432/travel
DATABASE_URL=

# Optional. Both turn on "Sign in with Google" and per-account "My trips"; without them everyone is a guest.
# GOOGLE_CLIENT_ID is the OAuth web client id from Google Cloud Console (the same value as the web app's NEXT_PUBLIC_GOOGLE_CLIENT_ID).
# SESSION_SECRET signs the agent's session tokens: 32+ random characters, e.g. `openssl rand -base64 48`. Never commit it.
GOOGLE_CLIENT_ID=
SESSION_SECRET=

# Whole-run timeout in ms.
RUN_TIMEOUT_MS=120000
# How long a finished run's packets stay available for reconnects, and how many packets are kept per run.
RUN_REPLAY_TTL_MS=600000
RUN_REPLAY_MAX_EVENTS=500
# Trip runs allowed per IP per window.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_RUNS=10
# Trip runs allowed per IP per 24 h, on top of the window above (protects the LLM bill).
RATE_LIMIT_DAILY_MAX_RUNS=30
USER_MAX_RUNS=3

# Optional LangSmith tracing; set both to trace every run (the threadId is attached as run metadata in the logs).
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=

# Reuse of flight/hotel searches in ms (default 30 min). Re-plans and repeat searches in this window skip SerpAPI.
# SEARCH_CACHE_TTL_MS=1800000
