# Copy to apps/agent/.env for local development. Blank values count as unset.

# development | test | production
NODE_ENV=development
# Defaults to CONDUCTOR_PORT + 1 under Conductor, otherwise 4000. Render sets it.
PORT=
# Comma-separated CORS allow-list. Defaults to http://localhost:${CONDUCTOR_PORT:-3000}; required in production.
WEB_ORIGIN=

# Required.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_FALLBACK_MODEL=claude-sonnet-5-5

# Optional. Without it, TOOLS_MODE=auto uses the offline mock engine.
SERPAPI_API_KEY=
# Optional. Gives the itinerary planner real attraction data.
TAVILY_API_KEY=
# auto (SerpAPI if a key is set, else mock) | live (SerpAPI only) | mock
TOOLS_MODE=auto

# Optional. postgres:// URL enables PostgresSaver; without it runs are kept in memory.
# Local Postgres: `docker compose up -d` in apps/agent, then DATABASE_URL=postgres://postgres:postgres@localhost:5432/travel
DATABASE_URL=

# Whole-run timeout in ms.
RUN_TIMEOUT_MS=120000
# How long a finished run's packets stay available for reconnects, and how many packets are kept per run.
RUN_REPLAY_TTL_MS=600000
RUN_REPLAY_MAX_EVENTS=500
# Trip runs allowed per IP per window.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_RUNS=10

# Optional LangSmith tracing; set both to trace every run (the threadId is attached as run metadata in the logs).
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
