# Copy to .env.local. Both values are public and optional.

# Agent base URL. `pnpm dev` defaults to http://localhost:$((CONDUCTOR_PORT + 1)) (or 4000).
# Leave unset in deployed builds until the agent exists — the app then runs in UI-only mode.
# NEXT_PUBLIC_AGENT_URL=http://localhost:4000

# URL-restricted public Mapbox token. Without it the map shows a placeholder.
# NEXT_PUBLIC_MAPBOX_TOKEN=

# Google OAuth web client id (public; the same value as the agent's GOOGLE_CLIENT_ID). Without it there is no sign-in and everyone is a guest.
# Authorized JavaScript origins in Google Cloud Console must include this app's origin (e.g. http://localhost:3000).
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Shows the "Technical log" button and panel. Off by default; LOG packets still stream and print to the console in development.
# NEXT_PUBLIC_SHOW_TECH_LOG=true
